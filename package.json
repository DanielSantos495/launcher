{
  "name": "account-launcher",
  "version": "0.0.0",
  "private": true,
  "description": "Launcher de cuentas por identidad para Brave, Chrome y Edge",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.2.2",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "typecheck": "tsc -p packages/core/tsconfig.json && tsc -p packages/protocol/tsconfig.json && pnpm --filter @account-launcher/extension typecheck",
    "lint": "pnpm --filter @account-launcher/extension prepare:types && eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm --filter @account-launcher/extension prepare:types && vitest run",
    "coverage": "pnpm --filter @account-launcher/extension prepare:types && vitest run --coverage",
    "build": "pnpm --filter @account-launcher/extension build",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm coverage && pnpm build"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@vitest/coverage-v8": "5.0.3",
    "eslint": "10.12.0",
    "globals": "17.13.0",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vitest": "5.0.3"
  }
}
